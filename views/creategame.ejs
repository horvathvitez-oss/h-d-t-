<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs létrehozása</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script src="/views/js/jquery-2.1.3.min.js"></script>
  <script src="/views/js/bootstrap.min.js"></script>
  <script src="/views/js/pace.min.js"></script>
  <script src="/views/js/modernizr.custom.js"></script>
</head>
<body class="parchment-screen app-shell-screen">
  <div class="parchment-overlay"></div>
  <div class="container parchment-app-container">
    <br>

    <header id="site-header" class="parchment-header">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
            <a href="/lobby" class="parchment-wordmark-link">
              <div class="brand-wordmark">HÓDÍTÓ</div>
              <div class="brand-tagline">az érettségi-játék</div>
            </a>
          </div>
        </div>
        <div class="col-md-8 col-sm-7 col-xs-4">
          <nav class="main-nav" role="navigation">
            <div class="collapse navbar-collapse">
              <ul class="nav navbar-nav navbar-right">
                <br><br>
                <li class="cl-effect-11"><a href="/lobby" data-hover="Home">Home</a></li>
                <li class="cl-effect-11"><a href="/profile" data-hover="Profile">Profile</a></li>
                <li class="cl-effect-11"><a href="/logout" data-hover="Logout">Logout</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <div class="promo-corner-card">
      <div class="promo-corner-title">Nem mennek a kérdések?</div>
      <div class="promo-corner-link">Középsulineked.com</div>
    </div>

    <div class="content-body">
      <div class="row">
        <div class="col-sm-8 col-md-6 col-md-offset-3">
          <div class="settings-card parchment-panel settings-card-tight">
            <h1>Create Match</h1>
            <p>Private match creation for exactly 3 players. After creating one, you will receive a 6-digit lobby code.</p>

            <form action="/creategame" method="post">
              <input type="hidden" name="maplevel" value="hard">

              <div class="form-group">
                <label>Játékosok</label>
                <input type="text" class="form-control input-lg parchment-input" value="3" disabled>
                <div class="hint">A jelenlegi játékmód pontosan 3 játékosra van felépítve.</div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg parchment-btn-primary">Create Match</button>
              <a href="/lobby" class="btn btn-default btn-lg parchment-btn-secondary">Back</a>
            </form>
          </div>
        </div>
      </div>
    </div>

    <footer id="site-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
  </div>

  <script src="/views/js/script.js"></script>
</body>
</html>
