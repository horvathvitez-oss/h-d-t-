<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs létrehozása</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script src="/views/js/jquery-2.1.3.min.js"></script>
  <script src="/views/js/bootstrap.min.js"></script>
  <script src="/views/js/pace.min.js"></script>
  <script src="/views/js/modernizr.custom.js"></script>
</head>
<body class="creategame-screen-v2" data-sound-base="/sounds">
  <div class="creategame-screen-v2__glow creategame-screen-v2__glow--top"></div>
  <div class="creategame-screen-v2__glow creategame-screen-v2__glow--bottom"></div>

  <main class="creategame-screen-v2__shell">
    <span class="creategame-screen-v2__line"></span>

    <section class="creategame-screen-v2__panel" aria-label="Meccs létrehozása">
      <div class="creategame-screen-v2__eyebrow">Új privát lobby</div>
      <h1>Meccs létrehozása</h1>

      <form action="/creategame" method="post" class="creategame-screen-v2__actions">
        <input type="hidden" name="maplevel" value="world">
        <button type="submit" class="btn btn-lg creategame-screen-v2__primary create-action-btn">Meccs létrehozása</button>
      </form>

      <a href="/lobby" class="btn btn-lg creategame-screen-v2__secondary create-action-btn">Vissza</a>
    </section>

    <span class="creategame-screen-v2__line"></span>
  </main>

  <script>
    var SOUND_BASE = document.body.getAttribute('data-sound-base') || '/sounds';
    var buttonClickAudio = null;

    function ensureCreateAudio() {
      if (!buttonClickAudio) {
        buttonClickAudio = new Audio(SOUND_BASE + '/button_click.mp3');
        buttonClickAudio.preload = 'none';
      }
    }

    function safePlay(audio) {
      if (!audio) return;
      try {
        var promise = audio.play();
        if (promise && typeof promise.catch === 'function') promise.catch(function () {});
      } catch (e) {}
    }

    function playButtonClickSound() {
      ensureCreateAudio();
      try {
        var clone = buttonClickAudio.cloneNode();
        clone.preload = 'none';
        safePlay(clone);
      } catch (e) {
        buttonClickAudio.currentTime = 0;
        safePlay(buttonClickAudio);
      }
    }

    Array.prototype.slice.call(document.querySelectorAll('.create-action-btn')).forEach(function(item) {
      item.addEventListener('click', function() {
        playButtonClickSound();
      });
    });
  </script>

  <script src="/views/js/script.js"></script>
</body>
</html>
