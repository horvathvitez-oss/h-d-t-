<!DOCTYPE html>
<html lang="hu">
<head>
  <title>HÓDÍTÓ / Profil</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css?v=waiting-profile-2026-04-16-1">

  <script src="/views/js/jquery-2.1.3.min.js"></script>
  <script src="/views/js/bootstrap.min.js"></script>
  <script src="/views/js/pace.min.js"></script>
  <script src="/views/js/modernizr.custom.js"></script>
</head>
<body class="parchment-screen app-shell-screen lobby-screen-modern profile-modern-screen" data-sound-base="/sounds">
  <div class="parchment-overlay"></div>

  <div class="top-promo-strip">
    <div class="top-promo-strip-track">
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
    </div>
  </div>

  <div class="container parchment-app-container profile-modern-shell">
    <header id="site-header" class="parchment-header profile-modern-header">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
            <a href="/lobby" class="parchment-wordmark-link">
              <div class="brand-wordmark">HÓDÍTÓ</div>
              <div class="brand-tagline">az érettségi-játék</div>
            </a>
          </div>
        </div>
        <div class="col-md-8 col-sm-7 col-xs-4">
          <nav class="main-nav main-nav-modern" role="navigation">
            <div class="collapse navbar-collapse">
              <ul class="nav navbar-nav navbar-right">
                <li class="cl-effect-11"><a href="/lobby" data-hover="Lobby">Lobby</a></li>
                <li class="cl-effect-11"><a href="/profile" data-hover="Profil">Profil</a></li>
                <li class="cl-effect-11"><a href="/logout" data-hover="Kilépés">Kilépés</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main class="content-body profile-modern-content">
      <section class="page-intro-card profile-modern-header-card">
        <div class="profile-modern-summary">
          <div class="waiting-room-v2-kicker">Profil</div>
          <h1>A saját Hódító profilod</h1>
          <p>Itt látod a fiókadataidat és a játékhoz kapcsolódó alapinformációkat. A dizájn most a lobby vizuális rendszeréhez igazodik, reszponzívan.</p>
        </div>
      </section>

      <section class="profile-modern-grid">
        <aside class="profile-modern-card profile-modern-sidebar reveal-delay-1">
          <div class="profile-modern-avatar-wrap">
            <img src="http://placehold.it/380x500" alt="Profilkép" class="profile-modern-avatar">
          </div>
          <div class="profile-modern-badge">
            <i class="ion-trophy"></i>
            Hódító játékos
          </div>
        </aside>

        <div class="profile-modern-main">
          <section class="profile-modern-card profile-modern-headline reveal-delay-1">
            <div class="profile-modern-kicker">Fiók</div>
            <h2 class="profile-modern-name"><%= username %></h2>
            <div class="profile-modern-email">
              <i class="glyphicon glyphicon-envelope"></i>
              <span><%= email %></span>
            </div>
          </section>

          <section>
            <div class="profile-modern-stats">
              <article class="profile-modern-card profile-modern-stat reveal-delay-1">
                <div class="profile-modern-stat-label">Lejátszott meccsek</div>
                <div class="profile-modern-stat-value">--</div>
                <div class="profile-modern-stat-note">Játsz több meccset, hogy itt valódi stat jelenjen meg.</div>
              </article>

              <article class="profile-modern-card profile-modern-stat reveal-delay-2">
                <div class="profile-modern-stat-label">Nyert meccsek</div>
                <div class="profile-modern-stat-value">--</div>
                <div class="profile-modern-stat-note">Menj fel a ranglistán és töltsd meg ezt a mezőt.</div>
              </article>

              <article class="profile-modern-card profile-modern-stat reveal-delay-2">
                <div class="profile-modern-stat-label">Fiók állapota</div>
                <div class="profile-modern-stat-value">Aktív</div>
                <div class="profile-modern-stat-note">A profil használatra kész és a lobby dizájnjához igazodik.</div>
              </article>
            </div>
          </section>

          <section class="profile-modern-card profile-modern-info reveal-delay-2">
            Játsz több meccset, hogy később megjelenhessenek a részletes eredményeid, előrehaladásod és további profilstatisztikáid.
          </section>
        </div>
      </section>
    </main>

    <footer id="site-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
  </div>

  <script src="/views/js/script.js"></script>
</body>
</html>
