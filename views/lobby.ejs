  <script>
    function joinByCode() {
      var input = document.getElementById('joinCode');
      var feedback = document.getElementById('joinFeedback');
      var code = (input.value || '').trim();

      if (!/^\d{6}$/.test(code)) {
        feedback.textContent = 'Adj meg egy érvényes, 6 jegyű lobbykódot.';
        return;
      }

      feedback.textContent = '';
      window.location.href = '/lobby/' + code;
    }

    document.getElementById('joinButton').addEventListener('click', joinByCode);
    document.getElementById('joinCode').addEventListener('keydown', function(event) {
      if (event.which === 13) {
        event.preventDefault();
        joinByCode();
      }
    });
  </script>

  <script>
    (function () {
      var previewSets = {
        world: {
          title: 'VILÁGTÉRKÉP',
          subtitle: 'A klasszikus pályán ezek a karakterek érhetők el.',
          cards: [
            {
              modifier: 'brutus',
              tag: 'A ravasz',
              name: 'Brutus',
              image: '/images/character-brutus.webp',
              description: 'EXTRA szabotázs gombja van. Ha használod, az ellenfeled kérdése megtükröződik.'
            },
            {
              modifier: 'einstein',
              tag: 'A magabiztos',
              name: 'Einstein',
              image: '/images/character-einstein.webp',
              description: '+3 segítséggel rendelkezik.'
            },
            {
              modifier: 'napoleon',
              tag: 'A rizikós',
              name: 'Napóleon',
              image: '/images/character-napoleon.webp',
              description: 'Ha övé EGÉSZ EURÓPA, +800 pontot kap.'
            }
          ]
        },
        hungary13: {
          title: 'NAGYMAGYARORSZÁG',
          subtitle: 'Itt a magyar pályára szabott karakterek jelennek meg.',
          cards: [
            {
              modifier: 'szilardleo',
              tag: 'A végzetes',
              name: 'Szilárd Leó',
              image: '/images/character-szilardleo.webp',
              description: '+1 segítséged van ÉS EGY atombombád, amit ha ledobsz vagy kapsz egy területet, vagy veszít az enemy vára 1 HP-t.'
            },
            {
              modifier: 'horthy',
              tag: 'A kékvérű',
              name: 'Horthy Miklós',
              image: '/images/character-horthy.webp',
              description: 'Ha tied a teljes FELVIDÉK és ERDÉLY, +400 pontot kapsz.'
            },
            {
              modifier: 'szechenyi',
              tag: 'Az aranykezű',
              name: 'Széchényi',
              image: '/images/character-szechenyi.webp',
              description: 'Ha benyomod a „kaszinó” gombot és megszerzed az adott területet, +200 pontot kapsz. Ha nem szerzed meg, -200-at kapsz.'
            }
          ]
        }
      };

      var activeMode = 'world';
      var grid = document.getElementById('lobbyCharacterGrid');
      var title = document.getElementById('lobbyCharacterPreviewTitle');
      var subtitle = document.getElementById('lobbyCharacterPreviewSubtitle');
      var pills = Array.prototype.slice.call(document.querySelectorAll('[data-preview-mode]'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-character-card]'));
      var swapTimer = null;

      function applyMode(mode, animated) {
        var config = previewSets[mode] || previewSets.world;
        activeMode = mode;

        pills.forEach(function (pill) {
          var isActive = pill.getAttribute('data-preview-mode') === mode;
          pill.classList.toggle('is-active', isActive);
          pill.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        if (!grid || !cards.length) return;
        if (title) title.textContent = config.title;
        if (subtitle) subtitle.textContent = config.subtitle;
        grid.setAttribute('data-preview-mode', mode);

        if (swapTimer) {
          clearTimeout(swapTimer);
          swapTimer = null;
        }

        var renderCards = function () {
          cards.forEach(function (card, index) {
            var item = config.cards[index];
            if (!item) return;
            card.className = 'lobby-v3-character lobby-v3-character--' + item.modifier;
            var tag = card.querySelector('.lobby-v3-character-tag');
            var img = card.querySelector('.lobby-v3-character-media img');
            var name = card.querySelector('.lobby-v3-character-body h2');
            var desc = card.querySelector('.lobby-v3-character-body p');
            if (tag) tag.textContent = item.tag;
            if (img) {
              img.src = item.image;
              img.alt = item.name + ' karaktere';
            }
            if (name) name.textContent = item.name;
            if (desc) desc.textContent = item.description;
          });
        };

        if (!animated) {
          renderCards();
          grid.classList.remove('is-swapping');
          return;
        }

        grid.classList.add('is-swapping');
        swapTimer = setTimeout(function () {
          renderCards();
          grid.classList.remove('is-swapping');
        }, 220);
      }

      pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
          var nextMode = pill.getAttribute('data-preview-mode');
          if (!nextMode || nextMode === activeMode) return;
          applyMode(nextMode, true);
        });
      });

      applyMode(activeMode, false);
    })();
  </script>

  <script>
    (function () {
      var facts = [
        'Tanuld meg az összes 1848-as előtti/utáni hosszú esszé témát, így nem érhet meglepetés érettségin.',
        'Magyarból KIZÁRÓLAG a romantika témakör megtanulása akár elég lehet az 5-öshöz',
        'A Középsulineked.com-on 3500 FT-ért tudsz töriből és irodalomból leérettségizni.',
        'Munkanélküli vagy.',
        'Ezt a játékot NEKTEK csináltuk konkrétan, szóval remélem tetszik.',
        'Az érettségivel rendelkező emberek 40% többet keresnek, mint akiknek nincs.'
      ];

      var text = document.getElementById('didYouKnowText');
      var bar = document.getElementById('didYouKnowBar');
      if (!text || !bar || !facts.length) return;

      var index = 0;
      var duration = 7000;

      function renderFact() {
        text.textContent = facts[index];
        bar.style.animation = 'none';
        bar.offsetHeight;
        bar.style.animation = 'lobbyTriviaProgress ' + duration + 'ms linear forwards';
      }

      renderFact();
      setInterval(function () {
        index = (index + 1) % facts.length;
        renderFact();
      }, duration);
    })();
  </script>

  <script>
    var SOUND_BASE = document.body.getAttribute('data-sound-base') || '/sounds';
    var lobbyBgAudio = null;
    var buttonClickAudio = null;

    function ensureLobbyAudio() {
      if (!lobbyBgAudio) {
        lobbyBgAudio = new Audio(SOUND_BASE + '/lobby_bg.mp3');
        lobbyBgAudio.loop = true;
        lobbyBgAudio.preload = 'none';
      }
      if (!buttonClickAudio) {
        buttonClickAudio = new Audio(SOUND_BASE + '/button_click.mp3');
        buttonClickAudio.preload = 'none';
      }
    }

    function safePlay(audio) {
      if (!audio) return;
      try {
        var promise = audio.play();
        if (promise && typeof promise.catch === 'function') promise.catch(function () {});
      } catch (e) {}
    }

    function startLobbyMusic() {
      ensureLobbyAudio();
      safePlay(lobbyBgAudio);
    }

    function playButtonClickSound() {
      ensureLobbyAudio();
      try {
        var clone = buttonClickAudio.cloneNode();
        clone.preload = 'none';
        safePlay(clone);
      } catch (e) {
        buttonClickAudio.currentTime = 0;
        safePlay(buttonClickAudio);
      }
    }

    document.addEventListener('click', startLobbyMusic, { once: true, capture: true });
    document.addEventListener('keydown', startLobbyMusic, { once: true, capture: true });

    Array.prototype.slice.call(document.querySelectorAll('a.lobby-action-btn, button.lobby-action-btn')).forEach(function(item) {
      item.addEventListener('click', function() {
        playButtonClickSound();
      });
    });
  </script>

  
<script>
  (function () {
    var videos = Array.prototype.slice.call(document.querySelectorAll('.lobby-side-ad-video'));
    if (!videos.length) return;

    function harden(video) {
      video.controls = false;
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      video.setAttribute('controlsList', 'nodownload noplaybackrate noremoteplayback nofullscreen');
      video.setAttribute('disablepictureinpicture', '');
    }

    function safeStart(video) {
      if (!video || video.dataset.started === '1') return;
      harden(video);
      video.dataset.started = '1';
      try {
        var p = video.play();
        if (p && typeof p.catch === 'function') {
          p.catch(function () {
            video.dataset.started = '0';
          });
        }
      } catch (e) {
        video.dataset.started = '0';
      }
    }

    videos.forEach(function (video) {
      harden(video);
    });

    window.addEventListener('load', function () {
      videos.forEach(safeStart);
    });

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) videos.forEach(safeStart);
    });
  })();
</script>

<script>
  (function () {
    var currentUsername = <%- JSON.stringify(username) %>;
    var leaderboardTop20 = <%- JSON.stringify(leaderboardTop20 || []) %>;
    var myStats = <%- JSON.stringify(myStats || { wins: 0, games: 0, rank: null }) %>;
    var expanded = false;
    var list = document.getElementById('hoditoLeaderboardList');
    var toggle = document.getElementById('hoditoLeaderboardToggle');
    var empty = document.getElementById('hoditoLeaderboardEmpty');
    var myRank = document.getElementById('hoditoLeaderboardMyRank');
    var myWins = document.getElementById('hoditoLeaderboardMyWins');
    var myGames = document.getElementById('hoditoLeaderboardMyGames');

    function getRankClass(rank) {
      if (rank === 1) return 'is-medal is-rank-1';
      if (rank === 2) return 'is-medal is-rank-2';
      if (rank === 3) return 'is-medal is-rank-3';
      return '';
    }

    function safeText(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function updateMyStats(nextStats) {
      if (!nextStats) return;
      myStats = nextStats;
      if (myRank) myRank.textContent = nextStats.rank ? ('#' + nextStats.rank) : '--';
      if (myWins) myWins.textContent = Number(nextStats.wins || 0);
      if (myGames) myGames.textContent = Number(nextStats.games || 0);
    }

    function renderLeaderboard() {
      if (!list || !toggle || !empty) return;
      var rows = Array.isArray(leaderboardTop20) ? leaderboardTop20 : [];
      list.innerHTML = '';

      if (!rows.length) {
        empty.hidden = false;
        toggle.hidden = true;
        return;
      }

      empty.hidden = true;
      toggle.hidden = rows.length <= 5;
      rows.forEach(function (entry, index) {
        if (!entry) return;
        var row = document.createElement('li');
        var rank = Number(entry.rank || (index + 1));
        var rowClass = 'hodito-leaderboard-row';
        if (entry.username === currentUsername) rowClass += ' is-current-user';
        if (!expanded && index >= 5) row.hidden = true;
        row.className = rowClass;
        row.innerHTML = [
          '<span class="hodito-leaderboard-rank ' + getRankClass(rank) + '">#' + rank + '</span>',
          '<span class="hodito-leaderboard-player">',
            '<a class="hodito-leaderboard-name" href="/profile/' + encodeURIComponent(entry.username) + '">' + safeText(entry.username) + '</a>',
            '<span class="hodito-leaderboard-meta">Random meccsek: ' + Number(entry.randomMatchmakingGames || 0) + '</span>',
          '</span>',
          '<span class="hodito-leaderboard-wins">' + Number(entry.randomMatchmakingWins || 0) + ' győzelem</span>'
        ].join('');
        list.appendChild(row);
      });

      toggle.textContent = expanded ? 'kevesebb' : 'több...';
    }

    if (toggle) {
      toggle.addEventListener('click', function () {
        expanded = !expanded;
        renderLeaderboard();
      });
    }

    renderLeaderboard();
    updateMyStats(myStats);

    if (typeof io !== 'function') return;
    var lobbySocket = io('/lobby', {
      transports: ['websocket', 'polling'],
      upgrade: true
    });

    lobbySocket.on('connect', function () {
      lobbySocket.emit('getLeaderboard', { username: currentUsername });
    });

    function applyPayload(payload) {
      if (!payload) return;
      leaderboardTop20 = Array.isArray(payload.leaderboardTop20) ? payload.leaderboardTop20 : leaderboardTop20;
      if (payload.myStats) updateMyStats(payload.myStats);
      renderLeaderboard();
    }

    lobbySocket.on('leaderboard:init', applyPayload);
    lobbySocket.on('leaderboard:update', applyPayload);
  })();
</script>

  <script defer src="/views/js/script.js"></script>
</body>
</html>
