        <span class="hodito-leaderboard-stat-note">Csak az online random matchmaking győzelmek számítanak.</span>
      </article>
      <article class="hodito-leaderboard-stat">
        <span class="hodito-leaderboard-stat-label">Lejátszott random meccsek</span>
        <span id="hoditoLeaderboardMyGames" class="hodito-leaderboard-stat-value"><%= myStats ? (myStats.games || 0) : 0 %></span>
        <span class="hodito-leaderboard-stat-note">Összesen ennyi random ellen játszottál.</span>
      </article>
    </div>

    <div id="hoditoLeaderboardEmpty" class="hodito-leaderboard-empty" hidden>Még nincs elérhető játékos a ranglétrán.</div>
    <ol id="hoditoLeaderboardList" class="hodito-leaderboard-list"></ol>
    <div class="hodito-leaderboard-controls">
      <button id="hoditoLeaderboardToggle" type="button" class="hodito-leaderboard-toggle">több...</button>
    </div>
  </div>
</section>

    </main>

    <footer id="site-footer" class="lobby-v3-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
