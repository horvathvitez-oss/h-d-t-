<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs lobby</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script src="/views/js/jquery-2.1.3.min.js"></script>
  <script src="/views/js/bootstrap.min.js"></script>
  <script src="/views/js/pace.min.js"></script>
  <script src="/views/js/modernizr.custom.js"></script>
</head>
<body class="parchment-screen app-shell-screen lobby-screen-modern">
  <div class="parchment-overlay"></div>
  <div class="top-promo-strip">
    <div class="top-promo-strip-track">
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
    </div>
  </div>

  <div class="container parchment-app-container lobby-app-container">
    <header id="site-header" class="parchment-header lobby-header-modern">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
            <a href="/lobby" class="parchment-wordmark-link">
              <div class="brand-wordmark">HÓDÍTÓ</div>
              <div class="brand-tagline">az érettségi-játék</div>
            </a>
          </div>
        </div>
        <div class="col-md-8 col-sm-7 col-xs-4">
          <nav class="main-nav main-nav-modern" role="navigation">
            <div class="collapse navbar-collapse">
              <ul class="nav navbar-nav navbar-right">
                <li class="cl-effect-11"><a href="/lobby" data-hover="Lobby">Lobby</a></li>
                <li class="cl-effect-11"><a href="/profile" data-hover="Profil">Profil</a></li>
                <li class="cl-effect-11"><a href="/logout" data-hover="Kilépés">Kilépés</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <div class="content-body lobby-content-modern">
      <div class="row">
        <main class="col-md-12">
          <div class="page-intro-card page-intro-card-modern reveal-card">
            <h1>Üdv, <%= username %>!</h1>
            <p>Hozz létre egy privát, 3 fős meccset, vagy csatlakozz egy kapott kóddal.</p>
          </div>
        </main>
      </div>

      <div class="row lobby-card-row">
        <div class="col-md-6">
          <div class="menu-card parchment-panel menu-card-modern reveal-card reveal-delay-1">
            <div class="menu-card-glow"></div>
            <h2>Meccs létrehozása</h2>
            <p>Indíts egy új privát lobbít. A rendszer ad egy 6 jegyű kódot, amit megoszthatsz a másik két játékossal.</p>
            <a href="/newgame" class="btn btn-primary btn-lg parchment-btn-primary lobby-action-btn">Meccs létrehozása</a>
          </div>
        </div>

        <div class="col-md-6">
          <div class="menu-card parchment-panel menu-card-modern reveal-card reveal-delay-2">
            <div class="menu-card-glow"></div>
            <h2>Csatlakozás meccshez</h2>
            <p>Írd be a hosttól kapott 6 jegyű lobbykódot, és lépj be azonnal a váróba.</p>
            <div class="form-group">
              <input id="joinCode" type="text" class="form-control input-lg parchment-input lobby-code-input" maxlength="6" placeholder="6 jegyű lobbykód">
            </div>
            <button id="joinButton" type="button" class="btn btn-success btn-lg parchment-btn-success lobby-action-btn">Csatlakozás</button>
            <div id="joinFeedback" class="join-feedback"></div>
          </div>
        </div>
      </div>
    </div>

    <footer id="site-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    function joinByCode() {
      var input = document.getElementById('joinCode');
      var feedback = document.getElementById('joinFeedback');
      var code = (input.value || '').trim();

      if (!/^\d{6}$/.test(code)) {
        feedback.textContent = 'Adj meg egy érvényes, 6 jegyű lobbykódot.';
        return;
      }

      feedback.textContent = '';
      window.location.href = '/lobby/' + code;
    }

    document.getElementById('joinButton').addEventListener('click', joinByCode);
    document.getElementById('joinCode').addEventListener('keydown', function(event) {
      if (event.which === 13) {
        event.preventDefault();
        joinByCode();
      }
    });
  </script>

  <script src="/views/js/script.js"></script>
</body>
</html>
