<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs lobby</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script defer src="/views/js/jquery-2.1.3.min.js"></script>
  <script defer src="/views/js/bootstrap.min.js"></script>
  <script defer src="/views/js/pace.min.js"></script>
  <script defer src="/views/js/modernizr.custom.js"></script>
  <script defer src="/socket.io/socket.io.js"></script>
  <style>
    .hodito-leaderboard-card { margin-top:24px; }
    .hodito-leaderboard-shell { display:grid; gap:18px; }
    .hodito-leaderboard-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; }
    .hodito-leaderboard-head h3 { margin:0; font-size:clamp(24px, 3vw, 34px); }
    .hodito-leaderboard-head p { margin:8px 0 0; color:rgba(50,38,24,0.78); }
    .hodito-leaderboard-summary { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:12px; }
    .hodito-leaderboard-stat { background:rgba(255,255,255,0.5); border:1px solid rgba(118,81,44,0.16); border-radius:18px; padding:14px 16px; box-shadow:0 12px 24px rgba(38,24,12,0.06); min-height:92px; }
    .hodito-leaderboard-stat-label { display:block; font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:rgba(72,50,28,0.66); }
    .hodito-leaderboard-stat-value { display:block; margin-top:6px; font-size:clamp(24px, 4vw, 36px); font-weight:800; color:#3b2816; line-height:1; }
    .hodito-leaderboard-stat-note { display:block; margin-top:8px; font-size:13px; color:rgba(59,40,22,0.74); }
    .hodito-leaderboard-list { list-style:none; margin:0; padding:0; display:grid; gap:10px; }
    .hodito-leaderboard-row { display:grid; grid-template-columns:64px minmax(0,1fr) auto; align-items:center; gap:12px; padding:14px 16px; border-radius:18px; background:linear-gradient(135deg, rgba(255,255,255,0.82), rgba(248,236,218,0.92)); border:1px solid rgba(121,86,47,0.18); box-shadow:0 14px 26px rgba(36,22,10,0.08); }
    .hodito-leaderboard-row.is-current-user { border-color:rgba(200,132,21,0.44); box-shadow:0 16px 32px rgba(160,102,18,0.16); }
    .hodito-leaderboard-rank { display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; font-weight:900; background:rgba(61,41,24,0.12); color:#3b2816; }
    .hodito-leaderboard-rank.is-medal { color:#fff; box-shadow:0 12px 24px rgba(0,0,0,0.16); }
    .hodito-leaderboard-rank.is-rank-1 { background:linear-gradient(135deg, #19d37d, #0b7f5f); }
    .hodito-leaderboard-rank.is-rank-2 { background:linear-gradient(135deg, #cf8cff, #7a4cff); }
    .hodito-leaderboard-rank.is-rank-3 { background:linear-gradient(135deg, #8fe2ff, #2c8fff); }
    .hodito-leaderboard-player { min-width:0; }
    .hodito-leaderboard-name { display:block; font-weight:800; color:#2d1b0f; text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .hodito-leaderboard-name:hover { color:#7f4f19; text-decoration:none; }
    .hodito-leaderboard-meta { display:block; margin-top:4px; color:rgba(63,43,24,0.72); font-size:13px; }
    .hodito-leaderboard-wins { font-weight:800; color:#5d3411; white-space:nowrap; }
    .hodito-leaderboard-controls { display:flex; align-items:center; justify-content:center; }
    .hodito-leaderboard-toggle { min-width:160px; border-radius:999px; padding:12px 20px; border:0; background:linear-gradient(135deg, #49301a, #8c5a21); color:#fff; font-weight:800; letter-spacing:.02em; box-shadow:0 14px 26px rgba(73,48,26,0.22); }
    .hodito-leaderboard-toggle[hidden] { display:none !important; }
    .hodito-leaderboard-empty { padding:20px; text-align:center; border-radius:18px; background:rgba(255,255,255,0.58); color:rgba(63,43,24,0.76); }
    @media (max-width: 991px) { .hodito-leaderboard-summary { grid-template-columns:1fr; } }
    @media (max-width: 640px) { .hodito-leaderboard-row { grid-template-columns:52px minmax(0,1fr); } .hodito-leaderboard-wins { grid-column:2; white-space:normal; } .hodito-leaderboard-rank { width:42px; height:42px; } .hodito-leaderboard-head { align-items:stretch; } }
  </style>
</head>
