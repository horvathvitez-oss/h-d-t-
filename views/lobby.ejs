<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs lobby</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script defer src="/views/js/jquery-2.1.3.min.js"></script>
  <script defer src="/views/js/bootstrap.min.js"></script>
  <script defer src="/views/js/pace.min.js"></script>
  <script defer src="/views/js/modernizr.custom.js"></script>
</head>
<body class="parchment-screen app-shell-screen lobby-screen-modern" data-sound-base="/sounds">
  <div class="parchment-overlay"></div>

  <div class="lobby-side-ads" aria-label="Középsulineked promóciós panelek">
    <a class="lobby-side-ad lobby-side-ad-left lobby-side-ad-static" href="https://kozepsulineked.com/products/30-napos-elofizetes-kozepsulineked" target="_blank" rel="noopener noreferrer sponsored">
      <span class="lobby-side-ad-badge">AJÁNLOTT</span>
      <span class="lobby-side-ad-title">KÖZÉPSULINEKED.COM</span>
      <span class="lobby-side-ad-copy">Érettségi felkészülés, gyors ismétlés, több tárgy egy helyen.</span>
      <span class="lobby-side-ad-caption">30 NAPOS ELŐFIZETÉS</span>
      <span class="lobby-side-ad-overlay"></span>
    </a>

    <a class="lobby-side-ad lobby-side-ad-right lobby-side-ad-static" href="https://kozepsulineked.com/products/30-napos-elofizetes-kozepsulineked" target="_blank" rel="noopener noreferrer sponsored">
      <span class="lobby-side-ad-badge">SEGÍTSÉG</span>
      <span class="lobby-side-ad-title">NEM MENNEK A KÉRDÉSEK?</span>
      <span class="lobby-side-ad-copy">Nyisd meg külön lapon, és készülj célzottan a játék közben előforduló témákra.</span>
      <span class="lobby-side-ad-caption">MEGNÉZEM</span>
      <span class="lobby-side-ad-overlay"></span>
    </a>
  </div>

  <div class="top-promo-strip">
    <div class="top-promo-strip-track">
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
    </div>
  </div>

  <div class="container parchment-app-container lobby-app-container">
    <header id="site-header" class="parchment-header lobby-header-modern">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
            <a href="/lobby" class="parchment-wordmark-link">
              <div class="brand-wordmark">HÓDÍTÓ</div>
              <div class="brand-tagline">az érettségi-játék</div>
            </a>
          </div>
        </div>
        <div class="col-md-8 col-sm-7 col-xs-4">
          <nav class="main-nav main-nav-modern" role="navigation">
            <div class="collapse navbar-collapse">
              <ul class="nav navbar-nav navbar-right">
                <li class="cl-effect-11"><a href="/lobby" data-hover="Lobby">Lobby</a></li>
                <li class="cl-effect-11"><a href="/profile" data-hover="Profil">Profil</a></li>
                <li class="cl-effect-11"><a href="/logout" data-hover="Kilépés">Kilépés</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <div class="content-body lobby-content-modern">
      <div class="row">
        <main class="col-md-12">
          <section class="page-intro-card page-intro-card-modern reveal-card lobby-hero-card">
            <div class="lobby-hero-mobile-line">Új meccs vagy gyors csatlakozás • 6 jegyű kóddal</div>
            <div class="lobby-hero-kicker">Privát 3 fős lobby</div>

            <div class="lobby-hero-split">
              <div class="lobby-hero-main">
                <h1>Üdv, <%= username %>!</h1>
                <p>
                  <span class="lobby-copy-desktop">
                    Hozz létre egy új meccset, oszd meg a 6 jegyű kódot, vagy csatlakozz azonnal egy már futó váróhoz.
                  </span>
                  <span class="lobby-copy-mobile">
                    Hozz létre új meccset, vagy csatlakozz azonnal a 6 jegyű kóddal.
                  </span>
                </p>
              </div>

              <aside class="lobby-hero-contact" aria-label="Javaslatküldés">
                <h3>Írj nekünk, és mi megcsináljuk!</h3>
                <p class="lobby-hero-contact-copy">
                  Ha írsz nekünk emailben egy javaslatot, 100% hogy megcsináljuk
                  (amennyiben értelmesnek találjuk).
                </p>

                <% if (typeof suggestionFlash !== 'undefined' && suggestionFlash) { %>
                  <div class="lobby-suggestion-flash lobby-suggestion-flash--<%= suggestionFlash.type %>">
                    <%= suggestionFlash.text %>
                  </div>
                <% } %>

                <form class="lobby-suggestion-form" action="/lobby/feature-request" method="post">
                  <input
                    type="text"
                    name="website"
                    class="lobby-honeypot"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                  >

                  <label class="lobby-input-label" for="featureRequestMessage">Javaslatod</label>
                  <textarea
                    id="featureRequestMessage"
                    name="message"
                    class="form-control parchment-input lobby-suggestion-textarea"
                    maxlength="2000"
                    placeholder="Írd meg röviden, mit szeretnél a játékban vagy a lobbyban."
                    required
                  ></textarea>

                  <div class="lobby-suggestion-footer">
                    <div class="lobby-suggestion-meta">
                      Vissza tudunk írni ide: <strong><%= email || 'nincs email megadva' %></strong>
                    </div>
                    <button
                      id="featureRequestSubmit"
                      type="submit"
                      class="btn btn-success btn-lg parchment-btn-success lobby-action-btn lobby-action-btn-spark lobby-suggestion-submit"
                    >
                      Javaslat elküldése
                    </button>
                  </div>
                </form>
              </aside>
            </div>
          </section>
        </main>
      </div>

      <div class="row lobby-card-row lobby-card-row-modern">
        <div class="col-md-6 lobby-card-col lobby-card-col-host">
          <section class="menu-card parchment-panel menu-card-modern lobby-choice-card reveal-card reveal-delay-1">
            <div class="menu-card-glow"></div>
            <div class="lobby-card-head">
              <span class="lobby-card-kicker">Host mód</span>
              <h2>Meccs létrehozása</h2>
            </div>
            <p class="lobby-card-copy">
              <span class="lobby-copy-desktop">
                Indíts új privát lobbít. A rendszer azonnal generál egy 6 jegyű kódot, amit továbbküldhetsz a másik két játékosnak.
              </span>
              <span class="lobby-copy-mobile">
                Indíts új privát lobbít, kapj 6 jegyű kódot, és küldd tovább a többieknek.
              </span>
            </p>
            <ul class="lobby-feature-list">
              <li>Azonnali 6 jegyű meghívókód</li>
              <li>Pontosan 3 játékosra optimalizálva</li>
              <li>Gyors belépés a várószobába</li>
            </ul>
            <div class="lobby-card-actions">
              <a href="/newgame" class="btn btn-primary btn-lg parchment-btn-primary lobby-action-btn lobby-action-btn-spark">Meccs létrehozása</a>
            </div>
          </section>
        </div>

        <div class="col-md-6 lobby-card-col lobby-card-col-join">
          <section class="menu-card parchment-panel menu-card-modern lobby-choice-card reveal-card reveal-delay-2">
            <div class="menu-card-glow"></div>
            <div class="lobby-card-head">
              <span class="lobby-card-kicker">Join mód</span>
              <h2>Csatlakozás meccshez</h2>
            </div>
            <p class="lobby-card-copy">
              <span class="lobby-copy-desktop">
                Írd be a hosttól kapott 6 jegyű lobbykódot, és lépj be azonnal a váróba. Nem kell frissítés, nem kell új oldal.
              </span>
              <span class="lobby-copy-mobile">
                Írd be a 6 jegyű kódot, és lépj be azonnal a váróba.
              </span>
            </p>
            <div class="lobby-join-shell">
              <label class="lobby-input-label" for="joinCode">Lobbykód</label>
              <div class="lobby-join-row">
                <input id="joinCode" type="text" class="form-control input-lg parchment-input lobby-code-input" maxlength="6" placeholder="6 jegyű lobbykód" inputmode="numeric" autocomplete="off">
                <button id="joinButton" type="button" class="btn btn-success btn-lg parchment-btn-success lobby-action-btn lobby-action-btn-spark">Csatlakozás</button>
              </div>
              <div id="joinFeedback" class="join-feedback"></div>
            </div>
          </section>
        </div>
      </div>
    </div>

    <footer id="site-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    function joinByCode() {
      var input = document.getElementById('joinCode');
      var feedback = document.getElementById('joinFeedback');
      var code = (input.value || '').trim();

      if (!/^\d{6}$/.test(code)) {
        feedback.textContent = 'Adj meg egy érvényes, 6 jegyű lobbykódot.';
        return;
      }

      feedback.textContent = '';
      window.location.href = '/lobby/' + code;
    }

    document.getElementById('joinButton').addEventListener('click', joinByCode);
    document.getElementById('joinCode').addEventListener('keydown', function(event) {
      if (event.which === 13) {
        event.preventDefault();
        joinByCode();
      }
    });
  </script>

  <script>
    var SOUND_BASE = document.body.getAttribute('data-sound-base') || '/sounds';
    var lobbyBgAudio = null;
    var buttonClickAudio = null;

    function ensureLobbyAudio() {
      if (!lobbyBgAudio) {
        lobbyBgAudio = new Audio(SOUND_BASE + '/lobby_bg.mp3');
        lobbyBgAudio.loop = true;
        lobbyBgAudio.preload = 'none';
      }
      if (!buttonClickAudio) {
        buttonClickAudio = new Audio(SOUND_BASE + '/button_click.mp3');
        buttonClickAudio.preload = 'none';
      }
    }

    function safePlay(audio) {
      if (!audio) return;
      try {
        var promise = audio.play();
        if (promise && typeof promise.catch === 'function') promise.catch(function () {});
      } catch (e) {}
    }

    function startLobbyMusic() {
      ensureLobbyAudio();
      safePlay(lobbyBgAudio);
    }

    function playButtonClickSound() {
      ensureLobbyAudio();
      try {
        var clone = buttonClickAudio.cloneNode();
        clone.preload = 'none';
        safePlay(clone);
      } catch (e) {
        buttonClickAudio.currentTime = 0;
        safePlay(buttonClickAudio);
      }
    }

    document.addEventListener('click', startLobbyMusic, { once: true, capture: true });
    document.addEventListener('keydown', startLobbyMusic, { once: true, capture: true });

    Array.prototype.slice.call(document.querySelectorAll('a.lobby-action-btn, button.lobby-action-btn')).forEach(function(item) {
      item.addEventListener('click', function() {
        playButtonClickSound();
      });
    });

    var suggestionForm = document.querySelector('.lobby-suggestion-form');
    if (suggestionForm) {
      suggestionForm.addEventListener('submit', function() {
        var submit = document.getElementById('featureRequestSubmit');
        if (!submit) return;
        submit.disabled = true;
        submit.textContent = 'Küldés...';
      });
    }
  </script>

  <script defer src="/views/js/script.js"></script>
</body>
</html>
