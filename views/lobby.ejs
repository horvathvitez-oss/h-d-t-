<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs lobby</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script defer src="/views/js/jquery-2.1.3.min.js"></script>
  <script defer src="/views/js/bootstrap.min.js"></script>
  <script defer src="/views/js/pace.min.js"></script>
  <script defer src="/views/js/modernizr.custom.js"></script>
  <style>
    .hodito-leaderboard-card {
      margin: 24px auto 0;
      width: 100%;
      max-width: 620px;
    }
    .hodito-leaderboard-shell {
      display: grid;
      gap: 14px;
      width: 100%;
    }
    .hodito-leaderboard-head {
      text-align: center;
      max-width: 420px;
      margin: 0 auto;
    }
    .hodito-leaderboard-head h3 {
      margin: 0;
      font-size: clamp(22px, 3vw, 30px);
      line-height: 1.1;
    }
    .hodito-leaderboard-head p {
      margin: 8px 0 0;
      color: rgba(50,38,24,0.78);
      font-size: 14px;
    }
    .hodito-leaderboard-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 8px;
    }
    .hodito-leaderboard-row {
      display: grid;
      grid-template-columns: 48px minmax(0,1fr) auto;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(248,236,218,0.92));
      border: 1px solid rgba(121,86,47,0.18);
      box-shadow: 0 10px 18px rgba(36,22,10,0.07);
    }
    .hodito-leaderboard-row.is-current-user {
      border-color: rgba(200,132,21,0.48);
      box-shadow: 0 12px 24px rgba(160,102,18,0.14);
    }
    .hodito-leaderboard-rank {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 999px;
      font-weight: 900;
      font-size: 13px;
      background: rgba(61,41,24,0.12);
      color: #3b2816;
    }
    .hodito-leaderboard-rank.is-medal {
      color: #fff;
      box-shadow: 0 10px 18px rgba(0,0,0,0.14);
    }
    .hodito-leaderboard-rank.is-rank-1 { background: linear-gradient(135deg, #19d37d, #0b7f5f); }
    .hodito-leaderboard-rank.is-rank-2 { background: linear-gradient(135deg, #cf8cff, #7a4cff); }
    .hodito-leaderboard-rank.is-rank-3 { background: linear-gradient(135deg, #8fe2ff, #2c8fff); }
    .hodito-leaderboard-name {
      display: block;
      font-weight: 800;
      font-size: 15px;
      color: #2d1b0f;
      text-decoration: none;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hodito-leaderboard-name:hover {
      color: #7f4f19;
      text-decoration: none;
    }
    .hodito-leaderboard-wins {
      font-weight: 800;
      font-size: 14px;
      color: #5d3411;
      white-space: nowrap;
    }
    .hodito-leaderboard-controls {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hodito-leaderboard-toggle {
      min-width: 120px;
      border-radius: 999px;
      padding: 10px 18px;
      border: 0;
      background: linear-gradient(135deg, #49301a, #8c5a21);
      color: #fff;
      font-weight: 800;
      letter-spacing: .02em;
      box-shadow: 0 12px 22px rgba(73,48,26,0.20);
    }
    .hodito-leaderboard-toggle[hidden] { display: none !important; }
    .hodito-leaderboard-empty {
      padding: 16px;
      text-align: center;
      border-radius: 16px;
      background: rgba(255,255,255,0.58);
      color: rgba(63,43,24,0.76);
    }
    @media (max-width: 640px) {
      .hodito-leaderboard-card { max-width: 100%; }
      .hodito-leaderboard-row {
        grid-template-columns: 40px minmax(0,1fr);
        gap: 8px;
        padding: 10px;
      }
      .hodito-leaderboard-rank {
        width: 32px;
        height: 32px;
        font-size: 12px;
      }
      .hodito-leaderboard-wins {
        grid-column: 2;
        font-size: 13px;
      }
      .hodito-leaderboard-name { font-size: 14px; }
      .hodito-leaderboard-head h3 { font-size: 22px; }
    }
  </style>
</head>
