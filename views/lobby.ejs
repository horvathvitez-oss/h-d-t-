<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Meccs lobby</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script defer src="/views/js/jquery-2.1.3.min.js"></script>
  <script defer src="/views/js/bootstrap.min.js"></script>
  <script defer src="/views/js/pace.min.js"></script>
  <script defer src="/views/js/modernizr.custom.js"></script>
</head>
<body class="parchment-screen app-shell-screen lobby-screen-modern lobby-v3" data-sound-base="/sounds">
  <div class="parchment-overlay"></div>

  <div class="lobby-side-ads" aria-label="Középsulineked promóciós panelek">
    <a class="lobby-side-ad lobby-side-ad-left" href="https://kozepsulineked.com/products/30-napos-elofizetes-kozepsulineked" target="_blank" rel="noopener noreferrer sponsored">
      <video
        class="lobby-side-ad-video"
        muted
        loop
        playsinline
        preload="none"
        poster="/images/lobby-side-promo-poster.webp"
        aria-hidden="true"
        disablepictureinpicture
      >
        <source src="/videos/lobby-side-promo.mp4" type="video/mp4">
      </video>
      <span class="lobby-side-ad-badge">AJÁNLOTT</span>
      <span class="lobby-side-ad-title">KÖZÉPSULINEKED.COM</span>
      <span class="lobby-side-ad-copy">Érettségi felkészülés, gyors ismétlés, több tárgy egy helyen.</span>
      <span class="lobby-side-ad-caption">MEGNÉZEM</span>
      <span class="lobby-side-ad-overlay"></span>
    </a>

    <a class="lobby-side-ad lobby-side-ad-right" href="https://kozepsulineked.com/products/30-napos-elofizetes-kozepsulineked" target="_blank" rel="noopener noreferrer sponsored">
      <video
        class="lobby-side-ad-video"
        muted
        loop
        playsinline
        preload="none"
        poster="/images/lobby-side-promo-poster.webp"
        aria-hidden="true"
        disablepictureinpicture
      >
        <source src="/videos/lobby-side-promo.mp4" type="video/mp4">
      </video>
      <span class="lobby-side-ad-badge">SEGÍTSÉG</span>
      <span class="lobby-side-ad-title">NEM MENNEK A KÉRDÉSEK?</span>
      <span class="lobby-side-ad-copy">Kattints rá, és készülj célzottan a játék közben előkerülő témákra.</span>
      <span class="lobby-side-ad-caption">KÖZÉPSULINEKED</span>
      <span class="lobby-side-ad-overlay"></span>
    </a>
  </div>

  <div class="top-promo-strip">
    <div class="top-promo-strip-track">
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
    </div>
  </div>

  <div class="container parchment-app-container lobby-app-container lobby-v3-shell">
    <header id="site-header" class="parchment-header lobby-header-modern lobby-v3-header">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
            <a href="/lobby" class="parchment-wordmark-link">
              <div class="brand-wordmark">HÓDÍTÓ</div>
              <div class="brand-tagline">az érettségi-játék</div>
            </a>
          </div>
        </div>
        <div class="col-md-8 col-sm-7 col-xs-4">
          <nav class="main-nav main-nav-modern" role="navigation">
            <div class="collapse navbar-collapse">
              <ul class="nav navbar-nav navbar-right">
                <li class="cl-effect-11"><a href="/lobby" data-hover="Lobby">Lobby</a></li>
                <li class="cl-effect-11"><a href="/profile" data-hover="Profil">Profil</a></li>
                <li class="cl-effect-11"><a href="/logout" data-hover="Kilépés">Kilépés</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main class="content-body lobby-v3-content">
      <section class="lobby-v3-user-row reveal-card">
        <div class="lobby-v3-user-badge">
          <span class="lobby-v3-user-label">Bejelentkezve</span>
          <strong><%= username %></strong>
        </div>
      </section>

      <section class="lobby-v3-characters reveal-card" aria-label="Karakterek">
        <article class="lobby-v3-character lobby-v3-character--brutus">
          <div class="lobby-v3-character-tag">A ravasz</div>
          <div class="lobby-v3-character-media">
            <img src="/images/character-brutus.webp" alt="Brutus karaktere" loading="lazy">
          </div>
          <div class="lobby-v3-character-body">
            <h2>Brutus</h2>
            <p>Megzavarja az ellenfelet, és váratlan helyzeteket teremt a döntő pillanatokban.</p>
          </div>
        </article>

        <article class="lobby-v3-character lobby-v3-character--einstein">
          <div class="lobby-v3-character-tag">A magabiztos</div>
          <div class="lobby-v3-character-media">
            <img src="/images/character-einstein.webp" alt="Einstein karaktere" loading="lazy">
          </div>
          <div class="lobby-v3-character-body">
            <h2>Einstein</h2>
            <p>Stabil előnyt épít, ha pontosan, higgadtan és következetesen játszol.</p>
          </div>
        </article>

        <article class="lobby-v3-character lobby-v3-character--napoleon">
          <div class="lobby-v3-character-tag">A rizikós</div>
          <div class="lobby-v3-character-media">
            <img src="/images/character-napoleon.webp" alt="Napóleon karaktere" loading="lazy">
          </div>
          <div class="lobby-v3-character-body">
            <h2>Napóleon</h2>
            <p>Nagyot nyerhet, de igazán annak való, aki szeret éles helyzetekre rámenni.</p>
          </div>
        </article>
      </section>

      <section class="lobby-v3-trivia reveal-card" aria-label="Tudtad érdekességek">
        <div class="lobby-v3-trivia-head">
          <span class="lobby-v3-trivia-kicker">Tudtad?</span>
          <span class="lobby-v3-trivia-meta">7 másodpercenként új érdekesség</span>
        </div>
        <div id="didYouKnowText" class="lobby-v3-trivia-text"></div>
        <div class="lobby-v3-trivia-progress" aria-hidden="true">
          <span id="didYouKnowBar"></span>
        </div>
      </section>

      <section class="lobby-v3-actions lobby-card-row-modern">
        <section class="menu-card parchment-panel lobby-v3-action-card lobby-v3-action-card--create reveal-card reveal-delay-1">
          <div class="lobby-v3-action-kicker">Host mód</div>
          <h3>Hozz létre egy meccset</h3>
          <p>Privát, 3 fős lobby, azonnali 6 jegyű kóddal.</p>
          <a href="/newgame" class="btn btn-primary btn-lg lobby-v3-primary-btn lobby-action-btn">Meccs létrehozása</a>
        </section>

        <section class="menu-card parchment-panel lobby-v3-action-card lobby-v3-action-card--join reveal-card reveal-delay-2">
          <div class="lobby-v3-action-kicker">Join mód</div>
          <h3>Csatlakozz kóddal</h3>
          <p>Írd be a 6 jegyű lobbykódot, és lépj be azonnal a váróba.</p>
          <div class="lobby-v3-join-shell">
            <label class="lobby-input-label lobby-v3-input-label" for="joinCode">Lobbykód</label>
            <div class="lobby-v3-join-row">
              <input id="joinCode" type="text" class="form-control input-lg lobby-v3-code-input" maxlength="6" placeholder="123456" inputmode="numeric" autocomplete="off">
              <button id="joinButton" type="button" class="btn btn-success btn-lg lobby-v3-secondary-btn lobby-action-btn">Csatlakozás</button>
            </div>
            <div id="joinFeedback" class="join-feedback lobby-v3-join-feedback"></div>
          </div>
        </section>
      </section>
    </main>

    <footer id="site-footer" class="lobby-v3-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    function joinByCode() {
      var input = document.getElementById('joinCode');
      var feedback = document.getElementById('joinFeedback');
      var code = (input.value || '').trim();

      if (!/^\d{6}$/.test(code)) {
        feedback.textContent = 'Adj meg egy érvényes, 6 jegyű lobbykódot.';
        return;
      }

      feedback.textContent = '';
      window.location.href = '/lobby/' + code;
    }

    document.getElementById('joinButton').addEventListener('click', joinByCode);
    document.getElementById('joinCode').addEventListener('keydown', function(event) {
      if (event.which === 13) {
        event.preventDefault();
        joinByCode();
      }
    });
  </script>

  <script>
    (function () {
      var facts = [
        'Történelemből az esszék pontszáma sokszor azon is múlik, mennyire tudod időrendben felépíteni az érvelést.',
        'Magyarból az idézett szöveg pontos értése gyakran többet ér, mint egy túl bonyolult megfogalmazás.',
        'Emelt töri érettségin a rövid és hosszú esszéknél a forráshasználat külön pontot ér.',
        'Matekból a részpontok miatt akkor is érdemes leírni a gondolatmenetet, ha nem vagy biztos a végeredményben.',
        'Egy jó érettségi stratégia sokszor nem a tudásod mennyiségén, hanem az időbeosztásodon áll vagy bukik.',
        'Nyelvi érettségin a biztos nyelvtani szerkezet általában többet ér, mint a kockázatos, látványos megoldás.'
      ];

      var text = document.getElementById('didYouKnowText');
      var bar = document.getElementById('didYouKnowBar');
      if (!text || !bar || !facts.length) return;

      var index = 0;
      var duration = 7000;

      function renderFact() {
        text.textContent = facts[index];
        bar.style.animation = 'none';
        bar.offsetHeight;
        bar.style.animation = 'lobbyTriviaProgress ' + duration + 'ms linear forwards';
      }

      renderFact();
      setInterval(function () {
        index = (index + 1) % facts.length;
        renderFact();
      }, duration);
    })();
  </script>

  <script>
    var SOUND_BASE = document.body.getAttribute('data-sound-base') || '/sounds';
    var lobbyBgAudio = null;
    var buttonClickAudio = null;

    function ensureLobbyAudio() {
      if (!lobbyBgAudio) {
        lobbyBgAudio = new Audio(SOUND_BASE + '/lobby_bg.mp3');
        lobbyBgAudio.loop = true;
        lobbyBgAudio.preload = 'none';
      }
      if (!buttonClickAudio) {
        buttonClickAudio = new Audio(SOUND_BASE + '/button_click.mp3');
        buttonClickAudio.preload = 'none';
      }
    }

    function safePlay(audio) {
      if (!audio) return;
      try {
        var promise = audio.play();
        if (promise && typeof promise.catch === 'function') promise.catch(function () {});
      } catch (e) {}
    }

    function startLobbyMusic() {
      ensureLobbyAudio();
      safePlay(lobbyBgAudio);
    }

    function playButtonClickSound() {
      ensureLobbyAudio();
      try {
        var clone = buttonClickAudio.cloneNode();
        clone.preload = 'none';
        safePlay(clone);
      } catch (e) {
        buttonClickAudio.currentTime = 0;
        safePlay(buttonClickAudio);
      }
    }

    document.addEventListener('click', startLobbyMusic, { once: true, capture: true });
    document.addEventListener('keydown', startLobbyMusic, { once: true, capture: true });

    Array.prototype.slice.call(document.querySelectorAll('a.lobby-action-btn, button.lobby-action-btn')).forEach(function(item) {
      item.addEventListener('click', function() {
        playButtonClickSound();
      });
    });
  </script>

  <script>
    (function () {
      var videos = Array.prototype.slice.call(document.querySelectorAll('.lobby-side-ad-video'));
      if (!videos.length) return;

      function harden(video) {
        video.controls = false;
        video.muted = true;
        video.setAttribute('controlsList', 'nodownload noplaybackrate noremoteplayback nofullscreen');
        video.setAttribute('disablepictureinpicture', '');
      }

      function safeStart(video) {
        if (!video || video.dataset.started === '1') return;
        video.dataset.started = '1';
        harden(video);
        try {
          var p = video.play();
          if (p && typeof p.catch === 'function') p.catch(function () {});
        } catch (e) {}
      }

      videos.forEach(harden);

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) safeStart(entry.target);
          });
        }, { threshold: 0.2 });

        videos.forEach(function (video) {
          observer.observe(video);
        });
      } else {
        videos.forEach(safeStart);
      }
    })();
  </script>

  <script defer src="/views/js/script.js"></script>
</body>
</html>
