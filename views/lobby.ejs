  <div class="container parchment-app-container lobby-app-container lobby-v3-shell">
    <header id="site-header" class="parchment-header lobby-header-modern lobby-v3-header">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
