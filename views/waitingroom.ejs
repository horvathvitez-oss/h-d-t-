<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Váróterem</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/views/css/bootstrap.min.css">
  <link rel="stylesheet" href="/views/css/ionicons.min.css">
  <link rel="stylesheet" href="/views/css/pace.css">
  <link rel="stylesheet" href="/views/css/custom.css">

  <script src="/views/js/jquery-2.1.3.min.js"></script>
  <script src="/views/js/bootstrap.min.js"></script>
  <script src="/views/js/pace.min.js"></script>
  <script src="/views/js/modernizr.custom.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="parchment-screen app-shell-screen lobby-screen-modern waiting-room-v2" data-sound-base="/sounds">
  <div class="parchment-overlay"></div>

  <div class="top-promo-strip">
    <div class="top-promo-strip-track">
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
      <span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span>
    </div>
  </div>

  <div class="container parchment-app-container waiting-room-shell waiting-room-v2-shell">
    <header id="site-header" class="parchment-header waiting-room-v2-header">
      <div class="row">
        <div class="col-md-4 col-sm-5 col-xs-8">
          <div class="logo parchment-wordmark-wrap">
            <a href="/lobby" class="parchment-wordmark-link">
              <div class="brand-wordmark">HÓDÍTÓ</div>
              <div class="brand-tagline">az érettségi-játék</div>
            </a>
          </div>
        </div>
        <div class="col-md-8 col-sm-7 col-xs-4">
          <nav class="main-nav main-nav-modern" role="navigation">
            <div class="collapse navbar-collapse">
              <ul class="nav navbar-nav navbar-right">
                <li class="cl-effect-11"><a href="/lobby" data-hover="Lobby">Lobby</a></li>
                <li class="cl-effect-11"><a href="/profile" data-hover="Profil">Profil</a></li>
                <li class="cl-effect-11"><a href="/logout" data-hover="Kilépés">Kilépés</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main class="content-body waiting-room-v2-content">
      <section class="waiting-room-v2-hero reveal-card">
        <div class="waiting-room-v2-kicker">Host váró</div>
        <h1>Várd meg, amíg mindenki belép</h1>
        <p>A meccs akkor indítható, ha pontosan 3 játékos van bent. Ha ketten vagytok, a host hozzáadhat 1 ChatGPT Botot.</p>

        <div class="waiting-room-v2-code-card">
          <div class="waiting-room-v2-code-label">Lobbykód</div>
          <div class="waiting-room-code" id="lobbyCode"><%= gameid %></div>
          <div class="waiting-room-copyhint">Küldd el ezt a 6 jegyű kódot a többieknek.</div>

          <div class="waiting-room-actions waiting-room-v2-actions">
            <button id="copyCodeButton" class="btn btn-default btn-lg waiting-room-v2-btn waiting-room-v2-btn--ghost" type="button">Kód másolása</button>
            <button id="addBotButton" class="btn btn-default btn-lg waiting-room-v2-btn waiting-room-v2-btn--ghost" type="button" disabled>ChatGPT Bot hozzáadása</button>
            <button id="startButton" class="btn btn-primary btn-lg waiting-room-v2-btn waiting-room-v2-btn--primary" type="button" disabled>Meccs indítása</button>
          </div>

          <div id="waitingStatus" class="waiting-room-status">Kapcsolódás a váróteremhez...</div>
          <div id="waitingError" class="waiting-room-error"></div>
        </div>
      </section>

      <section class="waiting-room-v2-grid">
        <aside class="waiting-room-side waiting-room-v2-card reveal-card reveal-delay-1">
          <div class="waiting-room-card-title">Játékosok</div>
          <div id="playersList" class="waiting-room-players"></div>
        </aside>

        <aside class="waiting-room-side waiting-room-v2-card reveal-card reveal-delay-2">
          <div class="waiting-room-card-title">Szabály</div>
          <ul class="waiting-room-bullet">
            <li>Pontosan 3 játékos szükséges.</li>
            <li>Ha csak ketten vagytok, a host 1 ChatGPT Botot adhat hozzá.</li>
            <li>Csak a host indíthatja el a meccset.</li>
            <li>Indítás után mindenki automatikusan belép a meccsbe.</li>
          </ul>
          <p class="waiting-room-note">A ChatGPT Bot arra való, hogy 2 emberrel is el lehessen indítani a 3 fős meccset. Ha valaki nem tud csatlakozni, ellenőrizze, hogy ugyanazt a kódot írta be.</p>
        </aside>
      </section>
    </main>

    <footer id="site-footer" class="waiting-room-v2-footer">
      <div class="row">
        <div class="col-md-12">
          <p class="copyright">HÓDÍTÓ</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    var gameid = '<%= gameid %>';
    var username = '<%= username %>';
    var socket = io('/lobby');
    var gameSocket = io('/' + gameid);

    var colorByIndex = ['#ff6a63', '#2fd37d', '#5097ff'];
    var latestLobbyState = null;
    var latestGameState = null;
    var BOT_NAME = 'ChatGPT Bot';

    function getRequiredPlayerCount() {
      if (latestGameState && latestGameState.game && latestGameState.game.howmany) {
        return Number(latestGameState.game.howmany) || 3;
      }
      return 3;
    }

    function getHostName() {
      if (latestLobbyState && latestLobbyState.host) return latestLobbyState.host;
      if (latestGameState && Array.isArray(latestGameState.players) && latestGameState.players.length) {
        return latestGameState.players[0].name;
      }
      return username;
    }

    function getDisplayPlayers() {
      if (latestGameState && Array.isArray(latestGameState.players)) {
        return latestGameState.players
          .filter(function(player) { return player.name && player.name !== 'x'; })
          .sort(function(a, b) { return a.pid - b.pid; })
          .map(function(player) {
            return {
              name: player.name,
              isBot: !!player.isBot || player.name === BOT_NAME
            };
          });
      }

      if (latestLobbyState && Array.isArray(latestLobbyState.players)) {
        return latestLobbyState.players.map(function(playerName) {
          return { name: playerName, isBot: playerName === BOT_NAME };
        });
      }

      return [];
    }

    function buildMirrorPlayerNames() {
      if (latestLobbyState && Array.isArray(latestLobbyState.players) && latestLobbyState.players.length) {
        return latestLobbyState.players.slice();
      }
      return getDisplayPlayers().filter(function(player) { return !player.isBot; }).map(function(player) { return player.name; });
    }

    function updateWaitingStatus(message) {
      document.getElementById('waitingStatus').textContent = message;
    }

    function renderPlayers() {
      var list = document.getElementById('playersList');
      var players = getDisplayPlayers();
      var hostName = getHostName();
      var requiredPlayers = getRequiredPlayerCount();
      var humanCount = players.filter(function(player) { return !player.isBot; }).length;
      var hasBot = players.some(function(player) { return player.isBot; });
      var phase = latestGameState && latestGameState.game ? latestGameState.game.phase : 'WAITING_FOR_PLAYERS';

      list.innerHTML = players.map(function(player, index) {
        var role = player.name === hostName ? 'Host' : (player.isBot ? 'ChatGPT Bot' : 'Játékos');
        var roleClass = player.isBot ? ' waiting-room-player-role--bot' : '';
        return [
          '<div class="waiting-room-player waiting-room-v2-player">',
          '<span class="waiting-room-player-dot" style="background:' + (colorByIndex[index] || '#b69f79') + '"></span>',
          '<div>',
          '<div class="waiting-room-player-name">' + player.name + '</div>',
          '<div class="waiting-room-player-role' + roleClass + '">' + role + '</div>',
          '</div>',
          '</div>'
        ].join('');
      }).join('');

      document.getElementById('startButton').disabled = !(phase === 'WAITING_FOR_PLAYERS' && players.length === requiredPlayers && username === hostName);
      document.getElementById('addBotButton').disabled = !(phase === 'WAITING_FOR_PLAYERS' && username === hostName && !hasBot && humanCount === requiredPlayers - 1 && players.length === requiredPlayers - 1);

      if (phase !== 'WAITING_FOR_PLAYERS') {
        updateWaitingStatus('A meccs indul, átirányítás...');
        return;
      }

      if (!hasBot && humanCount === requiredPlayers - 1) {
        updateWaitingStatus(players.length + '/' + requiredPlayers + ' játékos bent van. Ha ketten vagytok, a host most hozzáadhat 1 ChatGPT Botot.');
        return;
      }

      updateWaitingStatus(players.length + '/' + requiredPlayers + ' játékos bent van.');
    }

    function syncWaitingRoomToGame() {
      if (!gameSocket || !gameSocket.connected || !latestLobbyState) return;
      gameSocket.emit('syncWaitingRoomPlayers', {
        username: username,
        players: latestLobbyState.players || []
      });
    }

    socket.on('connect', function() {
      socket.emit('joinLobby', { gameid: gameid, username: username });
    });

    gameSocket.on('connect', function() {
      syncWaitingRoomToGame();
    });

    socket.on('lobbyState', function(lobby) {
      latestLobbyState = lobby;
      renderPlayers();
      document.getElementById('waitingError').textContent = '';
      syncWaitingRoomToGame();
    });

    gameSocket.on('stateSnapshot', function(snapshot) {
      latestGameState = snapshot;
      renderPlayers();
      document.getElementById('waitingError').textContent = '';
      if (snapshot && snapshot.game && snapshot.game.phase && snapshot.game.phase !== 'WAITING_FOR_PLAYERS') {
        window.location.href = '/game/' + gameid;
      }
    });

    socket.on('matchStarted', function(payload) {
      window.location.href = '/game/' + payload.gameid;
    });

    gameSocket.on('matchStarted', function(payload) {
      window.location.href = '/game/' + payload.gameid;
    });

    socket.on('lobbyClosed', function() {
      window.location.href = '/lobby';
    });

    socket.on('lobbyError', function(payload) {
      document.getElementById('waitingError').textContent = payload.message || 'Hiba történt.';
    });

    gameSocket.on('serverstatus', function(messages) {
      if (!messages || !messages.length) return;
      updateWaitingStatus(messages[messages.length - 1]);
    });

    document.getElementById('startButton').addEventListener('click', function() {
      gameSocket.emit('hostStartMatch', {
        username: username,
        players: buildMirrorPlayerNames()
      });
    });

    document.getElementById('addBotButton').addEventListener('click', function() {
      gameSocket.emit('addBotPlayer', {
        username: username,
        players: buildMirrorPlayerNames()
      });
    });

    document.getElementById('copyCodeButton').addEventListener('click', function() {
      var value = document.getElementById('lobbyCode').textContent.trim();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(value);
      }
      updateWaitingStatus('A kód kimásolva: ' + value);
    });
  </script>

  <script>
    var SOUND_BASE = document.body.getAttribute('data-sound-base') || '/sounds';
    var lobbyBgAudio = new Audio(SOUND_BASE + '/lobby_bg.mp3');
    var buttonClickAudio = new Audio(SOUND_BASE + '/button_click.mp3');
    lobbyBgAudio.loop = true;

    function safePlay(audio) {
      if (!audio) return;
      try {
        var promise = audio.play();
        if (promise && typeof promise.catch === 'function') promise.catch(function () {});
      } catch (e) {}
    }

    function startLobbyMusic() {
      safePlay(lobbyBgAudio);
    }

    function playButtonClickSound() {
      try {
        var clone = buttonClickAudio.cloneNode();
        safePlay(clone);
      } catch (e) {
        buttonClickAudio.currentTime = 0;
        safePlay(buttonClickAudio);
      }
    }

    document.addEventListener('click', startLobbyMusic, { once: true, capture: true });
    document.addEventListener('keydown', startLobbyMusic, { once: true, capture: true });

    Array.prototype.slice.call(document.querySelectorAll('#copyCodeButton, #addBotButton, #startButton')).forEach(function (item) {
      item.addEventListener('click', function () {
        playButtonClickSound();
      });
    });
  </script>

  <script src="/views/js/script.js"></script>
</body>
</html>
