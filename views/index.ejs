<!DOCTYPE html>
<html>
<head>
  <title>HÓDÍTÓ / Térkép</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />




  <link rel="stylesheet" href="../../../public/map/lib/leaflet/leaflet.css" />
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" />
  <link rel="stylesheet" href="../../../public/map/style/style.css" />
  <link rel="stylesheet" href="/views/css/custom.css?v=winner-stage-20260415-5" />




  <script src="../../../public/map/lib/leaflet/leaflet.js"></script>
  <% if (maplevel === 'hungary13') { %>
  <script src="../../../public/map/data/hungary13.geojson"></script>
  <script src="../../../public/map/data/hungary13_background.geojson"></script>
  <% } else if (maplevel === 'medium') { %>
  <script src="../../../public/map/data/countries30.geojson"></script>
  <% } else { %>
  <script src="../../../public/map/data/countries.geojson"></script>
  <% } %>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>




  <script type="text/javascript">
    var userid = '<%=userid%>';
    var username = '<%=username%>';
    var maplevel = '<%=maplevel%>';
    var howmany = '<%=howmany%>';
    var gameid = '<%=gameid%>';
    var creater = '<%=creater%>';
  </script>
</head>
<body class="game-screen" data-sound-base="/sounds">
  <div class="game-top-promo-strip"><div class="game-top-promo-strip-track"><span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span><span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span><span>NEM MENNEK A KÉRDÉSEK? - KÖZÉPSULINEKED.COM</span></div></div>
  <div id="game-shell">
    <div id="map"></div>




    <div id="phase-splash" class="phase-splash" aria-hidden="true">
      <div class="phase-splash-inner">
        <div class="phase-splash-overline">HÓDÍTÓ</div>
        <div id="phase-splash-title" class="phase-splash-title">BÁZISFOGLALÁS</div>
      </div>
    </div>




    <div id="winner-modal" class="winner-modal" aria-hidden="true">
      <div class="winner-modal-backdrop"></div>
      <div id="winner-confetti-layer" class="winner-confetti-layer" aria-hidden="true"></div>
      <div class="winner-modal-panel winner-modal-panel--podium">
        <div id="winner-finale-overlay" class="winner-finale-overlay" aria-hidden="true"></div>
        <div id="winner-spotlight" class="winner-spotlight" aria-hidden="true"></div>
        <div class="winner-modal-scroll">
          <div class="winner-modal-kicker">A meccs véget ért</div>
          <h2 id="winner-title" class="winner-modal-title">Ki fog átmenni az érettségin?</h2>
          <p id="winner-subtitle" class="winner-modal-subtitle"></p>
          <div id="winner-podium" class="winner-podium"></div>
          <div id="winner-summary" class="winner-summary"></div>
        </div>
        <div class="winner-modal-actions">
          <a href="/lobby" class="btn btn-primary btn-lg parchment-btn-primary">Vissza a lobbiba</a>
        </div>
      </div>
    </div>




    <header class="hud-top">
      <div class="brand-card">
        <img src="../../../views/img/logo.png" alt="HÓDÍTÓ" class="hud-logo" />
        <div class="brand-meta">
          <div class="room-line">Meccs kód: <strong><%=gameid%></strong></div>
          <div class="room-line">Játékos: <strong><%=username%></strong></div>
          <div class="room-line">Host: <strong><%=creater%></strong></div>
        </div>
      </div>
      <div id="playercards" class="player-cards"></div>
    </header>




    <aside class="hud-side hud-left">
      <section class="hud-card phase-card compact-phase-card">
        <div class="hud-card-title">Játékszakasz</div>
        <div id="phaseboard"></div>
      </section>




      <section class="hud-card order-card compact-order-card">
        <div class="hud-card-title">Sorrend</div>
        <div id="ordermeta" class="order-meta"></div>
        <div id="orderboard"></div>
      </section>
    </aside>




    <aside class="hud-side hud-right">
      <section class="hud-card status-card compact-status-card">
        <div class="hud-card-title">Státusz</div>
        <div id="gamestatus" class="status-line">Betöltés...</div>
        <div id="ordersummary" class="order-summary"></div>
      </section>





  <script src="/map/gamelogic.js?v=winner-stage-20260415-5"></script>
</body>
</html>
